  "version": "0.2.0",
  "authors": [
    {
      "name": "Theorikkdk"
    }
  ],
  "url": "https://github.com/theorikkdk/remote-action",
  "manifest": "https://github.com/theorikkdk/remote-action/releases/latest/download/module.json",
  "download": "https://github.com/theorikkdk/remote-action/releases/download/v0.2.0/remote-action.zip",
  "readme": "https://github.com/theorikkdk/remote-action/blob/main/README.md",
